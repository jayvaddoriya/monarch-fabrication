# ==========================================
# MONARCH FABRICATION - Environment Configuration
# ==========================================

# Canonical Domain URL (used for sitemaps, robots.txt, OpenGraph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://monarchfabrication.in

# Email Delivery Provider (Optional but recommended for live enquiry delivery)
# Provider: Resend (https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Recipient Email Address where customer quotation requests will be delivered
CONTACT_RECEIVER_EMAIL=contact@monarchfabrication.com
